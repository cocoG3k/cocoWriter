{
  "schemaVersion": 1,
  "articleDirectory": "src/content/journey",
  "imageDirectory": "public/images/blog/journey",
  "imagePublicPath": "/images/blog/journey",
  "filenameTemplate": "ios-{id}.md",
  "articleExtensions": [
    "md",
    "markdown"
  ],
  "excludedArticleNames": [
    "_index.md",
    "_template.md"
  ],
  "frontMatter": {
    "format": "yaml",
    "fields": {
      "title": "title",
      "description": "description",
      "date": "date",
      "tags": "tags"
    },
    "requireDescription": false,
    "dateStyle": "date",
    "timeZone": "Asia/Tokyo",
    "extra": {
      "draft": false
    }
  },
  "imageReferenceStyle": "site-relative",
  "preview": {
    "templateFile": "../preview-templates/sfuji-journey.html"
  }
}
